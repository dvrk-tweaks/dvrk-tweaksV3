<Window x:Class="DvrkTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVRK Tweaks V3"
        Width="1380"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        Background="#08080C"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111117"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#17171F"/>
        <SolidColorBrush x:Key="BorderBrushDvrk" Color="#272733"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9292A4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#15151D"/>
            <Setter Property="BorderBrush" Value="#292936"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20202B"/>
                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="DvrkToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" CornerRadius="13" Background="#2A2A34" BorderBrush="#3A3A46" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#8F8F9C" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#6D3DE0"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A78BFA"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0D0D12" BorderBrush="#22222B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,22,18,16">
                    <TextBlock Text="DVRK" FontSize="30" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="TWEAKS V3" FontSize="11" FontWeight="SemiBold" Foreground="#9A8BFF" Margin="0,2,0,0"/>
                    <TextBlock Text="PERFORMANCE CONTROL PANEL" FontSize="9" Foreground="#676775" Margin="0,8,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav" Margin="10,0,10,12"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="12,8,12,14">
                    <Button Content="🌐  WEBSITE" Click="Website" HorizontalContentAlignment="Left"/>
                    <Button Content="💬  DISCORD" Click="Discord" HorizontalContentAlignment="Left"/>
                    <Button Content="▶  YOUTUBE" Click="Youtube" HorizontalContentAlignment="Left"/>
                    <Button Content="↩  GO BACK" Click="Back" HorizontalContentAlignment="Left"/>
                    <Button Content="✕  EXIT" Click="Exit" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F0F15" BorderBrush="#252531" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DVRK TWEAKS" FontSize="12" FontWeight="Bold" Foreground="#9A8BFF"/>
                        <TextBlock Text="Gaming performance control panel" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#172016" BorderBrush="#2B4930" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <TextBlock Text="● READY" Foreground="#8BE28F" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="MainContent"/>
        </Grid>
    </Grid>
</Window>
